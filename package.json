{
  "name": "forma-nutri",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:cloud": "npm run build && wrangler dev",
    "db:local": "wrangler d1 execute forma-nutri --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute forma-nutri --remote --file=./schema.sql",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "miniflare": "5.20261113.0-beta",
    "vite": "^6.1.0",
    "wrangler": "^4.10.0"
  }
}
